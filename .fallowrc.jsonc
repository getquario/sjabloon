{
  "$schema": "./node_modules/fallow/schema.json",
  // Reached by `tsc` through tsconfig's `include`, not by an import or a script
  // path, so it sits outside the graph fallow walks from package.json.
  "entry": ["test/types.check.ts"],
  // Nested package with its own manifest, installed and run by
  // `npm run bench:comparison`. Nothing in this package imports it.
  "ignorePatterns": ["bench/comparison/**"],
  // Stryker resolves `testRunner: "tap"` to this package by naming convention at
  // run time, so no import or script path names it.
  "ignoreDependencies": ["@stryker-mutator/tap-runner"],
  // `types.d.ts` is the hand-written declaration of what `core.js` exports, so
  // the two name the same functions by design.
  "ignoreExports": [
    { "file": "lib/core.js", "exports": ["isDiagnostic", "relocate"] },
    { "file": "lib/types.d.ts", "exports": ["isDiagnostic", "relocate"] },
  ],
  "health": {
    "ignore": ["bench/**", "fuzz/**"],
  },
  "typeAware": {
    "enabled": true,
    "projects": ["tsconfig.json"],
    "require": "best-effort",
  },
}
